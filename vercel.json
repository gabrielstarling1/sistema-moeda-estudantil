{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "src/main/resources/static",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sistema-moeda-estudantil-api.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://sistema-moeda-estudantil-api.onrender.com/uploads/:path*"
    }
  ]
}
